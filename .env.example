# Optional settings for the Alchemy stacks. Nothing here is required to run
# Case Desk; export the ones you need in your shell before `plan` or `deploy`:
#   set -a; . ./.env; set +a

# Prefix for the Worker names, for a second deployment on the same account
# (`test-` gives test-app, test-iter1, ...). Leave empty for the main one.
CASE_DESK_WORKER_PREFIX=

# E-mail address for the alerts stack (pnpm alerts:plan, pnpm alerts:deploy).
ALERT_EMAIL=
