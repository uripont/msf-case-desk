# Optional settings. Nothing here is required to run Quoroom; export the ones
# you need in your shell before `plan` or `deploy`:
#   set -a; . ./.env; set +a
#
# `pnpm cloudflare:*` and `pnpm test-env:*` choose their own stage and refuse to
# run when this file selects an Alchemy profile, account or credentials.

# E-mail address for the alerts stack (pnpm alerts:plan, pnpm alerts:deploy).
ALERT_EMAIL=

# The course's demo stack only (pnpm demo:*): a prefix for its Worker names,
# for a second copy on the same account (`test-` gives test-app, test-iter1, ...).
QUOROOM_WORKER_PREFIX=
