{
  "name": "quoroom",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "pnpm --filter @quoroom/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "check": "pnpm typecheck && pnpm lint && pnpm migrations:check && pnpm test && pnpm build",
    "snapshots:prepare": "sh scripts/prepare-snapshots.sh",
    "migrations:check": "node scripts/check-migrations.mjs",
    "users:add": "pnpm --filter @quoroom/api users:add",
    "grant-admin": "pnpm --filter @quoroom/api grant-admin",
    "compat:check": "sh scripts/compat-check.sh",
    "smoke": "node scripts/smoke.mjs",
    "rehearsal": "node packages/e2e/src/rehearsal.ts",
    "workerd": "sh infra/workerd.sh",
    "cloudflare:plan": "node infra/cloudflare.mjs plan",
    "cloudflare:deploy": "node infra/cloudflare.mjs deploy",
    "cloudflare:destroy": "node infra/cloudflare.mjs destroy",
    "test-env:up": "node infra/cloudflare.mjs up",
    "test-env:down": "node infra/cloudflare.mjs down",
    "alerts:plan": "alchemy plan infra/alerts.run.ts",
    "alerts:deploy": "alchemy deploy infra/alerts.run.ts",
    "alerts:destroy": "alchemy destroy infra/alerts.run.ts",
    "demo:plan": "alchemy plan infra/demo.run.ts",
    "demo:deploy": "alchemy deploy infra/demo.run.ts",
    "demo:destroy": "alchemy destroy infra/demo.run.ts"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@effect/platform-node": "4.0.6",
    "@types/node": "^24.19.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
