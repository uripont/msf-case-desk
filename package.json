{
  "name": "msf-case-desk",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "pnpm --filter @case-desk/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "check": "pnpm typecheck && pnpm lint && pnpm migrations:check && pnpm test && pnpm build",
    "infra:plan": "alchemy plan",
    "infra:deploy": "alchemy deploy",
    "infra:dev": "alchemy dev",
    "infra:destroy": "alchemy destroy",
    "snapshots:prepare": "sh scripts/prepare-snapshots.sh iter1",
    "migrations:check": "node scripts/check-migrations.mjs",
    "users:add": "pnpm --filter @case-desk/api users:add",
    "compat:check": "sh scripts/compat-check.sh",
    "demo:refresh": "pnpm --filter @case-desk/api demo:seed",
    "workerd": "sh scripts/workerd.sh",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
    "@effect/platform-node": "4.0.6",
    "@types/node": "^24.19.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
